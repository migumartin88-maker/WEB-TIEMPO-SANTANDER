---
interface Props {
  city?: string;
  latitude?: number;
  longitude?: number;
  timezone?: string;
  threshold?: number;
}

const {
  city = 'Santander',
  latitude = 43.4623,
  longitude = -3.80998,
  timezone = 'Europe/Madrid',
  threshold = 50,
} = Astro.props;
---

<section
  class="decision decision--loading"
  data-umbrella-decision
  data-city={city}
  data-latitude={latitude}
  data-longitude={longitude}
  data-timezone={timezone}
  data-threshold={threshold}
  aria-live="polite"
  aria-atomic="true"
>
  <div class="decision-visual" aria-hidden="true">
    <span class="visual-symbol" data-umbrella-icon>☂️</span>
    <span class="visual-symbol" data-face-icon>…</span>
  </div>
  <p class="decision-kicker">DECISIÓN PARA SALIR</p>
  <h1 class="decision-title" data-verdict>Consultando el tiempo</h1>
  <p class="decision-copy" data-copy>Comprobando la lluvia prevista en las próximas tres horas.</p>

  <div class="probability">
    <span class="probability-value" data-probability>—</span>
    <span class="probability-label">probabilidad máxima<br />en las próximas 3 horas</span>
  </div>

  <p class="threshold-note" data-threshold-note>El umbral para llevar paraguas es del {threshold}%.</p>
  <p class="decision-error" data-error hidden>No se pudo consultar la previsión. Comprueba tu conexión e inténtalo de nuevo.</p>

  <div class="decision-footer">
    <span data-updated>Previsión de Open-Meteo</span>
    <button class="refresh" data-refresh type="button">Actualizar</button>
  </div>
</section>

<script>
  const decisions = document.querySelectorAll('[data-umbrella-decision]');

  decisions.forEach((decision) => {
    const city = decision.dataset.city ?? 'Santander';
    const latitude = decision.dataset.latitude ?? '43.4623';
    const longitude = decision.dataset.longitude ?? '-3.80998';
    const timezone = decision.dataset.timezone ?? 'Europe/Madrid';
    const threshold = Number(decision.dataset.threshold ?? 50);
    const verdict = decision.querySelector('[data-verdict]');
    const copy = decision.querySelector('[data-copy]');
    const umbrellaIcon = decision.querySelector('[data-umbrella-icon]');
    const faceIcon = decision.querySelector('[data-face-icon]');
    const probability = decision.querySelector('[data-probability]');
    const thresholdNote = decision.querySelector('[data-threshold-note]');
    const updated = decision.querySelector('[data-updated]');
    const error = decision.querySelector('[data-error]');
    const refresh = decision.querySelector('[data-refresh]');

    thresholdNote.textContent = `El umbral para llevar paraguas es del ${threshold}%.`;

    async function updateDecision() {
      decision.classList.remove('decision--yes', 'decision--no', 'decision--error');
      decision.classList.add('decision--loading');
      verdict.textContent = 'Consultando el tiempo';
      copy.textContent = `Comprobando la lluvia prevista en ${city} durante las próximas tres horas.`;
      umbrellaIcon.textContent = '☂️';
      faceIcon.textContent = '…';
      probability.textContent = '—';
      error.hidden = true;
      refresh.disabled = true;

      const params = new URLSearchParams({
        latitude,
        longitude,
        current: 'temperature_2m',
        hourly: 'precipitation_probability',
        timezone,
        forecast_days: '2',
      });

      try {
        const response = await fetch(`https://api.open-meteo.com/v1/forecast?${params}`, { cache: 'no-store' });
        if (!response.ok) throw new Error('Weather request failed');

        const forecast = await response.json();
        const start = Date.parse(`${forecast.current.time}Z`);
        const end = start + 3 * 60 * 60 * 1000;
        const nextThreeHours = forecast.hourly.time
          .map((time, index) => ({
            timestamp: Date.parse(`${time}Z`),
            probability: forecast.hourly.precipitation_probability[index],
          }))
          .filter(({ timestamp, probability: value }) => timestamp >= start && timestamp <= end && Number.isFinite(value));

        if (!nextThreeHours.length) throw new Error('No hourly forecast available');

        const maxProbability = Math.max(...nextThreeHours.map(({ probability: value }) => value));
        const takeUmbrella = maxProbability >= threshold;

        decision.classList.remove('decision--loading');
        decision.classList.add(takeUmbrella ? 'decision--yes' : 'decision--no');
        verdict.textContent = takeUmbrella ? 'Sí, coge paraguas' : 'No hace falta paraguas';
        copy.textContent = takeUmbrella
          ? `En ${city}, la lluvia puede superar el umbral mientras estás fuera.`
          : `La probabilidad de lluvia se mantiene por debajo del ${threshold}% en las próximas tres horas.`;
        umbrellaIcon.textContent = takeUmbrella ? '☂️' : '🌂';
        faceIcon.textContent = takeUmbrella ? '😟' : '😊';
        probability.textContent = `${Math.round(maxProbability)}%`;
        updated.textContent = `Actualizado a las ${forecast.current.time.slice(11, 16)}`;
      } catch {
        decision.classList.remove('decision--loading');
        decision.classList.add('decision--error');
        verdict.textContent = 'Previsión no disponible';
        copy.textContent = 'No podemos decidirlo sin consultar la probabilidad de lluvia.';
        umbrellaIcon.textContent = '☂️';
        faceIcon.textContent = '↻';
        error.hidden = false;
        updated.textContent = 'Datos de Open-Meteo';
      } finally {
        refresh.disabled = false;
      }
    }

    refresh.addEventListener('click', updateDecision);
    updateDecision();
  });
</script>

<style>
  .decision {
    width: min(100%, 540px);
    margin: 0 auto;
    padding: clamp(28px, 7vw, 54px);
    border: 1px solid #e6e7e0;
    border-radius: 24px;
    background: #fff;
    box-shadow: 0 18px 48px rgb(34 48 43 / 7%);
    text-align: center;
    color: #202a2a;
  }

  .decision-visual {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    margin: 0 auto 25px;
  }

  .visual-symbol {
    display: grid;
    width: 82px;
    height: 82px;
    place-items: center;
    border-radius: 50%;
    background: #f2f4ef;
    font-size: 42px;
    line-height: 1;
  }

  .decision-kicker {
    margin: 0;
    color: #77827c;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
  }

  .decision-title {
    margin: 10px 0 8px;
    font: 800 clamp(27px, 6vw, 38px)/1.12 'Manrope', sans-serif;
    letter-spacing: -1.4px;
  }

  .decision-copy {
    max-width: 360px;
    margin: 0 auto;
    color: #748079;
    font-size: 14px;
    line-height: 1.55;
  }

  .probability {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    margin: 30px auto 0;
    padding: 18px;
    border-top: 1px solid #eceee8;
    border-bottom: 1px solid #eceee8;
  }

  .probability-value {
    font: 800 40px/1 'Manrope', sans-serif;
    letter-spacing: -1.7px;
  }

  .probability-label {
    color: #758078;
    font-size: 12px;
    line-height: 1.45;
    text-align: left;
  }

  .threshold-note {
    margin: 15px 0 0;
    color: #8a938e;
    font-size: 12px;
  }

  .decision--yes [data-umbrella-icon], .decision--yes [data-face-icon] { background: #fff0d9; }
  .decision--yes .decision-title, .decision--yes .probability-value { color: #9a521e; }
  .decision--no [data-umbrella-icon], .decision--no [data-face-icon] { background: #e6f1e9; }
  .decision--no .decision-title, .decision--no .probability-value { color: #34705e; }
  .decision--error [data-umbrella-icon], .decision--error [data-face-icon] { background: #f8e8e4; }
  .decision--error .decision-title { color: #a64d39; }

  .decision-error {
    margin: 14px 0 0;
    color: #a64d39;
    font-size: 12px;
  }

  .decision-error[hidden] { display: none; }

  .decision-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 25px;
    color: #929b95;
    font-size: 11px;
  }

  .refresh {
    border: 1px solid #dce0d9;
    border-radius: 9px;
    padding: 9px 12px;
    background: #fff;
    color: #354b45;
    font: 600 12px 'DM Sans', sans-serif;
    cursor: pointer;
  }

  .refresh:hover { background: #f3f6f2; }
  .refresh:disabled { opacity: .55; cursor: wait; }
</style>
