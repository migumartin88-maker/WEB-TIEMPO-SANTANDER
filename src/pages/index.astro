---
import { inject } from '@vercel/analytics';
inject();
import WeatherDecision from '../components/WeatherDecision.astro';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f2f4ef" />
    <meta name="description" content="Consulta la probabilidad de lluvia y el viento en Santander. Decide si hoy te conviene llevar paraguas o chubasquero." />
    <title>¿Va a llover hoy en Santander? | Lluvia y viento</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet" />
    <style>
      :root {
        font-family: 'DM Sans', sans-serif;
        color: #1d302d;
        background: #f2f4ef;
        font-synthesis: none;
        text-rendering: optimizeLegibility;
      }

      * { box-sizing: border-box; }
      body {
        min-width: 320px;
        min-height: 100vh;
        margin: 0;
        background-image: radial-gradient(#dce5dc 0.7px, transparent 0.7px);
        background-size: 19px 19px;
      }

      main {
        display: flex;
        min-height: 100vh;
        flex-direction: column;
        padding: 0 28px;
      }

      .content { display: grid; flex: 1; place-items: center; padding: 42px 0; }

      @media (max-width: 560px) {
        main { padding: 0 18px; }
        .content { padding: 30px 0; }
      }
    </style>
  </head>
  <body>
    <main>
      <div class="content">
        <WeatherDecision city="Santander" threshold={40} windThreshold={39} gustThreshold={50} strongWindThreshold={50} />
      </div>
    </main>
  </body>
</html>
