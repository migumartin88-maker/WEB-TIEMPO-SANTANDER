---
import Analytics from '@vercel/analytics/astro';
import { inject } from '@vercel/analytics';
inject();
import UmbrellaAlert from '../components/UmbrellaAlert.astro';
export const prerender = true;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f4f5ef" />
    <meta
      name="description"
      content="Consulta la lluvia y el viento previstos en Santander para el tramo horario que elijas."
    />
    <title>¿Va a llover hoy en Santander? | Lluvia y viento</title>
    <link rel="canonical" href="https://sacoparaguas.vercel.app/" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Saco paraguas" />
    <meta property="og:url" content="https://sacoparaguas.vercel.app/" />
    <meta property="og:title" content="¿Saco paraguas hoy en Santander?" />
    <meta property="og:description" content="Lluvia y viento en Santander, tramo a tramo. Y si quieres, te avisamos cada mañana a las 7:30." />
    <meta property="og:image" content="https://sacoparaguas.vercel.app/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="¿Saco paraguas hoy? Lluvia y viento en Santander" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="¿Saco paraguas hoy en Santander?" />
    <meta name="twitter:description" content="Lluvia y viento en Santander, tramo a tramo. Y si quieres, te avisamos cada mañana a las 7:30." />
    <meta name="twitter:image" content="https://sacoparaguas.vercel.app/og.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet" />
    <style>
      :root {
        font-family: 'DM Sans', sans-serif;
        color: #203b35;
        background: #f4f5ef;
        font-synthesis: none;
        text-rendering: optimizeLegibility;
      }

      * { box-sizing: border-box; }
      body { min-width: 320px; min-height: 100vh; margin: 0; }
      main {
        width: min(calc(100% - 36px), 760px);
        min-height: 100vh;
        margin: 0 auto;
        padding: clamp(32px, 8vh, 78px) 0 38px;
      }

      @media (max-width: 480px) {
        main { width: calc(100% - 36px); padding-top: 38px; }
      }
    </style>
  </head>
  <body>
    <main>
      <UmbrellaAlert city="Santander" latitude={43.4623} longitude={-3.80998} timezone="Europe/Madrid" threshold={50} />
    </main>
    <Analytics />
  </body>
</html>
